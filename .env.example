NODE_ENV=development
API_GATEWAY_PORT=4000
# Basic HTTP request logs are always enabled; opt into sanitized details locally.
HTTP_LOG_HEADERS=false
HTTP_LOG_BODY=false
# Pretty JSON in development; production uses one JSON object per line.
LOG_PRETTY=true
# auto: red errors in a terminal; always: also through concurrently; never: plain JSON.
LOG_COLOR=auto
PAYMENT_SERVICE_HOST=127.0.0.1
PAYMENT_SERVICE_PORT=4010
MENU_SERVICE_HOST=127.0.0.1
MENU_SERVICE_PORT=4020
DATABASE_URL=postgresql://foodmenu:foodmenu@localhost:5432/foodmenu_api?schema=public
POSTGRES_USER=foodmenu
POSTGRES_PASSWORD=foodmenu
POSTGRES_DB=foodmenu_api
PGADMIN_DEFAULT_EMAIL=admin@foodmenu.local
PGADMIN_DEFAULT_PASSWORD=admin
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=
STUART_API_BASE_URL=https://api.sandbox.stuart.com
STUART_CLIENT_ID=
STUART_CLIENT_SECRET=
STUART_ACCOUNT_ID=
STUART_PICKUP_ADDRESS=32 Coombe Ln, Raynes Park, London SW20 0LA
STUART_PICKUP_LATITUDE=52.42441177368164
STUART_PICKUP_LONGITUDE=-1.5433413982391357
STUART_PICKUP_COMPANY=FoodMenu
STUART_PICKUP_FIRST_NAME=FoodMenu
STUART_PICKUP_LAST_NAME=Kitchen
STUART_PICKUP_PHONE=+447700900000
STUART_PICKUP_EMAIL=orders@foodmenu.local
STUART_PICKUP_COMMENT=FoodMenu order pickup
STUART_PICKUP_DELAY_MINUTES=15
STUART_PACKAGE_TYPE=medium
STUART_FALLBACK_CUSTOMER_PHONE=+447700900000
STUART_WEBHOOK_SECRET=
FOODMENU_APP_URL=http://localhost:8082
PUBLIC_ASSET_BASE_URL=http://localhost:4000
GOOGLE_ROUTES_API_KEY=
ORDER_SERVICE_HOST=127.0.0.1
ORDER_SERVICE_PORT=4030

# Google OAuth Web client ID(s), comma-separated. No client secret is needed.
GOOGLE_CLIENT_IDS=
# Login session lifetime (7 days). Log in again after expiry.
AUTH_SESSION_TTL_SECONDS=604800

# Private identity microservice (gateway connects over TCP)
IDENTITY_SERVICE_HOST=127.0.0.1
IDENTITY_SERVICE_PORT=4050
IDENTITY_SERVICE_TIMEOUT_MS=10000

# Email activation (codes expire four hours after SMTP accepts delivery; 7200 = two hours)
EMAIL_VERIFICATION_TTL_SECONDS=14400
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFICATION_SECRET=
# Mailtrap Email Sandbox: copy its SMTP username/password from Integration.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Shared between identity (writes) and gateway (serves). Public URLs use PUBLIC_ASSET_BASE_URL.
PROFILE_PHOTO_STORAGE_DIR=uploads/profile-photos

# AI Food Concierge: server-only Gemini credentials. Publish config with npm run ai:seed.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_CONCIERGE_MODEL=gemini-3.8-flash
AI_PROVIDER_TIMEOUT_MS=45000
AI_GUEST_TTL_SECONDS=86400
AI_RETENTION_DAYS=30
# Accepted turns per minute; guest chat creation is also limited per gateway-observed IP.
AI_ACCOUNT_RATE_LIMIT=20
AI_GUEST_RATE_LIMIT=5
AI_GUEST_CREATE_RATE_LIMIT=3
