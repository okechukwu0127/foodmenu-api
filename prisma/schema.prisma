generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  REQUIRES_CAPTURE
  CANCELED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum DefaultModifierScope {
  GLOBAL
  CATEGORY
  FOOD_ITEM
}

model PaymentTransaction {
  id              String          @id @default(cuid())
  paymentIntentId String          @unique
  amount          Int
  currency        String          @default("gbp")
  status          PaymentStatus
  provider        PaymentProvider @default(STRIPE)
  customerId      String?
  orderId         String?
  metadata        Json?
  refunds         PaymentRefund[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([provider])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

model Category {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  nameKey               String
  name                  Json?
  icon                  String?
  displayName           String?
  imageUrl              String?
  sortOrder             Int                    @default(0)
  isActive              Boolean                @default(true)
  foodItems             FoodItem[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model FoodItem {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  categoryId            String
  name                  String
  nameData              Json?
  description           String
  descriptionData       Json?
  price                 Int
  currency              String                  @default("GBP")
  calories              Int?
  prepTimeMinutes       Int?
  rating                Float?
  isPopular             Boolean                 @default(false)
  isRecommended         Boolean                 @default(false)
  isFoodAvailable       Boolean                 @default(true)
  discountPercent       Int?
  fulfillmentOptions    Json?
  sizeOptions           Json?
  sideOptions           Json?
  appetizerOptions      Json?
  tags                  String[]                @default([])
  isActive              Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                FoodImage[]
  deals                 Deal[]
  hotBurgerCombos       HotBurgerCombo[]
  modifierGroups        FoodItemModifierGroup[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isPopular])
  @@index([isRecommended])
  @@index([isFoodAvailable])
  @@index([sortOrder])
}

model FoodImage {
  id         String   @id @default(cuid())
  foodItemId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([foodItemId])
  @@index([sortOrder])
}

model Deal {
  id              String    @id @default(cuid())
  title           String
  offerType       Json?
  subtitle        String?
  offerDesc       Json?
  offerDelivery   Json?
  offerCategory   String[]  @default([])
  description     String?
  imageUrl        String?
  discountPercent Int?
  backgroundColor String?
  accentColor     String?
  foodItemId      String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  foodItem        FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([sortOrder])
  @@index([foodItemId])
}

model HeroSlide {
  id              String   @id @default(cuid())
  title           String
  titleData       Json?
  subtitle        String?
  subtitleData    Json?
  description     String?
  imageUrl        String
  discountPercent Int?
  discountLabel   String?
  ctaLabel        String?
  ctaTargetType   String?
  ctaTargetId     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model HotBurgerCombo {
  id                String    @id @default(cuid())
  title             String
  nameData          Json?
  subtitle          String?
  descriptionData   Json?
  items             Json?
  imageUrl          String?
  categoryLabel     String?
  categoryLabelData Json?
  price             Int?
  isFeatured        Boolean   @default(false)
  foodItemId        String?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  foodItem          FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([foodItemId])
}

model DrinkAddOn {
  id              String   @id @default(cuid())
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  price           Int
  imageUrl        String?
  tag             String?
  unitLabel       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ModifierGroup {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  title                 String
  nameData              Json?
  subtitle              String?
  descriptionData       Json?
  selectionType         ModifierSelectionType
  minSelections         Int                     @default(0)
  maxSelections         Int?
  quantityMode          String                  @default("none")
  isRequired            Boolean                 @default(false)
  sortOrder             Int                     @default(0)
  isActive              Boolean                 @default(true)
  options               ModifierOption[]
  foodItems             FoodItemModifierGroup[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  priceOffset     Int           @default(0)
  calories        Int?
  imageUrl        String?
  tag             String?
  isDefault       Boolean       @default(false)
  isPopular       Boolean       @default(false)
  maxQuantity     Int?
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([modifierGroupId])
  @@index([isActive])
  @@index([sortOrder])
}

model FoodItemModifierGroup {
  foodItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  foodItem        FoodItem      @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([foodItemId, modifierGroupId])
  @@index([foodItemId])
  @@index([modifierGroupId])
  @@index([sortOrder])
}

model DefaultModifierGroup {
  id              String               @id @default(cuid())
  modifierGroupId String
  scope           DefaultModifierScope
  categoryId      String?
  foodItemId      String?
  sortOrder       Int                  @default(0)
  modifierGroup   ModifierGroup        @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  foodItem        FoodItem?            @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([modifierGroupId])
  @@index([scope])
  @@index([categoryId])
  @@index([foodItemId])
  @@index([sortOrder])
}

model ModifierLabelTranslation {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
}

model AppetizerOption {
  id              String   @id @default(cuid())
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  price           Int
  imageUrl        String?
  calories        Int?
  tag             String?
  unitLabel       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model PaymentRefund {
  id              String             @id @default(cuid())
  refundId        String             @unique
  paymentIntentId String
  amount          Int?
  reason          String?
  status          PaymentStatus
  transaction     PaymentTransaction @relation(fields: [paymentIntentId], references: [paymentIntentId], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([paymentIntentId])
  @@index([status])
  @@index([createdAt])
}
