generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  REQUIRES_CAPTURE
  CANCELED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  PAYMENT_FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum DefaultModifierScope {
  GLOBAL
  CATEGORY
  FOOD_ITEM
}

enum FulfilmentStatus {
  NOT_REQUESTED
  QUOTE_REQUESTED
  CREATED
  COURIER_ASSIGNED
  PICKUP_STARTED
  PICKED_UP
  DROPOFF_STARTED
  DELIVERED
  CANCELED
  FAILED
}

model PaymentTransaction {
  id              String          @id @default(cuid())
  paymentIntentId String          @unique
  amount          Int
  currency        String          @default("gbp")
  status          PaymentStatus
  provider        PaymentProvider @default(STRIPE)
  customerId      String?
  orderId         String?
  metadata        Json?
  refunds         PaymentRefund[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([provider])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

model Customer {
  aiState          AiCustomerState?
  id               String                  @id
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  stripeCustomerId String?                 @unique
  isDemo           Boolean                 @default(false)
  metadata         Json?
  authAccount      AuthAccount?
  addresses        CustomerAddress[]       @relation("CustomerAddresses")
  defaultAddressId String?                 @db.VarChar(128)
  defaultAddress   CustomerAddress?        @relation("DefaultCustomerAddress", fields: [id, defaultAddressId], references: [customerId, addressId], onDelete: NoAction, onUpdate: NoAction)
  orders           Order[]
  paymentMethods   CustomerPaymentMethod[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([email])
  @@index([phone])
  @@index([isDemo])
}

model CustomerPaymentMethod {
  id                    String    @id @default(cuid())
  customerId            String
  stripeCustomerId      String
  stripePaymentMethodId String    @unique
  alias                 String?
  holderName            String?
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean   @default(false)
  deletedAt             DateTime?
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@index([stripeCustomerId])
  @@index([isDefault])
  @@index([deletedAt])
}

model Order {
  id                String                    @id @default(cuid())
  orderNumber       String                    @unique
  checkoutSessionId String?                   @unique
  customerId        String
  status            OrderStatus               @default(PENDING_PAYMENT)
  paymentIntentId   String?                   @unique
  amount            Int
  currency          String                    @default("gbp")
  subtotal          Int?
  deliveryFee       Int?
  taxAmount         Int?
  discountAmount    Int?
  notes             String?
  deliveryAddress   Json?
  metadata          Json?
  customer          Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fulfilments       OrderFulfilment[]
  items             OrderItem[]
  routeCaches       OrderTrackingRouteCache[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([customerId])
  @@index([checkoutSessionId])
  @@index([status])
  @@index([paymentIntentId])
  @@index([createdAt])
}

model OrderTrackingRouteCache {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  originLat   Float
  originLng   Float
  destLat     Float
  destLng     Float
  coordinates Json
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([orderId, status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  foodItemId   String?
  categoryId   String?
  name         String
  description  String?
  imageUrl     String?
  quantity     Int      @default(1)
  unitAmount   Int
  totalAmount  Int
  currency     String   @default("gbp")
  modifiers    Json?
  itemSnapshot Json?
  metadata     Json?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([foodItemId])
  @@index([categoryId])
}

model FulfilmentProvider {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  isActive    Boolean           @default(true)
  config      Json?
  fulfilments OrderFulfilment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isActive])
}

model OrderFulfilment {
  id                   String             @id @default(cuid())
  orderId              String
  fulfilmentProviderId String
  status               FulfilmentStatus   @default(NOT_REQUESTED)
  providerJobId        String?
  providerDeliveryId   String?
  trackingUrl          String?
  clientTrackingUrl    String?
  courierName          String?
  courierPhone         String?
  courierLatitude      Float?
  courierLongitude     Float?
  estimatedPickupAt    DateTime?
  estimatedDropoffAt   DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  failedReason         String?
  rawProviderPayload   Json?
  metadata             Json?
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             FulfilmentProvider @relation(fields: [fulfilmentProviderId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([orderId])
  @@index([fulfilmentProviderId])
  @@index([status])
  @@index([providerJobId])
  @@index([providerDeliveryId])
  @@index([createdAt])
}

model Category {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  nameKey               String
  name                  Json?
  icon                  String?
  displayName           String?
  imageUrl              String?
  sortOrder             Int                    @default(0)
  isActive              Boolean                @default(true)
  foodItems             FoodItem[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model FoodItem {
  dietaryInfo           Json?
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  categoryId            String
  name                  String
  nameData              Json?
  description           String
  descriptionData       Json?
  price                 Int
  currency              String                  @default("GBP")
  calories              Int?
  prepTimeMinutes       Int?
  rating                Float?
  isPopular             Boolean                 @default(false)
  isRecommended         Boolean                 @default(false)
  isFoodAvailable       Boolean                 @default(true)
  discountPercent       Int?
  fulfillmentOptions    Json?
  sizeOptions           Json?
  sideOptions           Json?
  appetizerOptions      Json?
  tags                  String[]                @default([])
  isActive              Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                FoodImage[]
  deals                 Deal[]
  hotCombos             HotCombo[]
  modifierGroups        FoodItemModifierGroup[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isPopular])
  @@index([isRecommended])
  @@index([isFoodAvailable])
  @@index([sortOrder])
}

model FoodImage {
  id         String   @id @default(cuid())
  foodItemId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([foodItemId])
  @@index([sortOrder])
}

model Deal {
  id              String    @id @default(cuid())
  title           String
  offerType       Json?
  subtitle        String?
  offerDesc       Json?
  offerDelivery   Json?
  offerCategory   String[]  @default([])
  description     String?
  imageUrl        String?
  discountPercent Int?
  backgroundColor String?
  accentColor     String?
  foodItemId      String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  foodItem        FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([sortOrder])
  @@index([foodItemId])
}

model HeroSlide {
  id              String   @id @default(cuid())
  title           String
  titleData       Json?
  subtitle        String?
  subtitleData    Json?
  description     String?
  imageUrl        String
  discountPercent Int?
  discountLabel   String?
  ctaLabel        String?
  ctaTargetType   String?
  ctaTargetId     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model HotCombo {
  id                String    @id @default(cuid())
  title             String
  nameData          Json?
  subtitle          String?
  descriptionData   Json?
  items             Json?
  imageUrl          String?
  categoryLabel     String?
  categoryLabelData Json?
  price             Int?
  isFeatured        Boolean   @default(false)
  foodItemId        String?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  foodItem          FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([foodItemId])
}

model DrinkAddOn {
  id              String   @id @default(cuid())
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  price           Int
  imageUrl        String?
  tag             String?
  unitLabel       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ModifierGroup {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  title                 String
  nameData              Json?
  subtitle              String?
  descriptionData       Json?
  selectionType         ModifierSelectionType
  minSelections         Int                     @default(0)
  maxSelections         Int?
  quantityMode          String                  @default("none")
  isRequired            Boolean                 @default(false)
  sortOrder             Int                     @default(0)
  isActive              Boolean                 @default(true)
  options               ModifierOption[]
  foodItems             FoodItemModifierGroup[]
  defaultModifierGroups DefaultModifierGroup[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  priceOffset     Int           @default(0)
  calories        Int?
  imageUrl        String?
  tag             String?
  isDefault       Boolean       @default(false)
  isPopular       Boolean       @default(false)
  maxQuantity     Int?
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([modifierGroupId])
  @@index([isActive])
  @@index([sortOrder])
}

model FoodItemModifierGroup {
  foodItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  foodItem        FoodItem      @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([foodItemId, modifierGroupId])
  @@index([foodItemId])
  @@index([modifierGroupId])
  @@index([sortOrder])
}

model DefaultModifierGroup {
  id              String               @id @default(cuid())
  modifierGroupId String
  scope           DefaultModifierScope
  categoryId      String?
  foodItemId      String?
  sortOrder       Int                  @default(0)
  modifierGroup   ModifierGroup        @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  foodItem        FoodItem?            @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([modifierGroupId])
  @@index([scope])
  @@index([categoryId])
  @@index([foodItemId])
  @@index([sortOrder])
}

model ModifierLabelTranslation {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
}

model AppetizerOption {
  id              String   @id @default(cuid())
  name            String
  nameData        Json?
  description     String?
  descriptionData Json?
  price           Int
  imageUrl        String?
  calories        Int?
  tag             String?
  unitLabel       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model PaymentRefund {
  id              String             @id @default(cuid())
  refundId        String             @unique
  paymentIntentId String
  amount          Int?
  reason          String?
  status          PaymentStatus
  transaction     PaymentTransaction @relation(fields: [paymentIntentId], references: [paymentIntentId], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([paymentIntentId])
  @@index([status])
  @@index([createdAt])
}

model AuthAccount {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String?
  googleSub         String?            @unique
  customerId        String             @unique
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions          AuthSession[]
  emailVerifiedAt   DateTime?
  emailVerification EmailVerification?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model AuthSession {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  accountId String
  account   AuthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model CustomerAddress {
  customerId String
  addressId  String     @db.VarChar(128)
  label      String     @db.VarChar(100)
  address    String     @db.VarChar(1000)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)
  defaultFor Customer[] @relation("DefaultCustomerAddress")

  @@id([customerId, addressId])
}

model EmailVerification {
  accountId   String      @id
  account     AuthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestId   String
  codeHash    String
  requestedAt DateTime    @default(now())
  sentAt      DateTime?
  expiresAt   DateTime?
  attempts    Int         @default(0)

  @@index([expiresAt])
}

// Concierge-owned data. Identity/menu business records are accessed through RPC.
model AiConfiguration {
  version   String   @id
  active    Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())

  @@index([active])
}

model AiCustomerState {
  defaultProfile       AiPreferenceProfile?  @relation("AiDefaultProfile", fields: [customerId, defaultProfileId], references: [customerId, id], onDelete: NoAction, onUpdate: NoAction)
  customerId           String                @id
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultProfileId     String?               @db.Uuid
  defaultRevision      Int                   @default(1)
  accountAnswers       Json                  @default("{}")
  accountConfigVersion String?
  accountRevision      Int                   @default(1)
  accountUpdatedAt     DateTime              @default(now())
  profiles             AiPreferenceProfile[]
  imports              AiProfileImport[]
  mappings             AiImportMapping[]
  conversations        AiConversation[]
}

model AiPreferenceProfile {
  mappings      AiImportMapping[] @relation("AiMappedProfile")
  defaultFor    AiCustomerState[] @relation("AiDefaultProfile")
  id            String            @id @db.Uuid
  customerId    String
  owner         AiCustomerState   @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  name          String            @db.VarChar(120)
  configVersion String
  answers       Json
  revision      Int               @default(1)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([customerId, id])
  @@index([customerId, deletedAt, createdAt])
}

model AiProfileImport {
  customerId  String
  importId    String          @db.Uuid
  owner       AiCustomerState @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  requestHash String
  result      Json
  createdAt   DateTime        @default(now())

  @@id([customerId, importId])
}

model AiImportMapping {
  profile    AiPreferenceProfile @relation("AiMappedProfile", fields: [customerId, profileId], references: [customerId, id], onDelete: NoAction, onUpdate: NoAction)
  customerId String
  localId    String              @db.Uuid
  profileId  String              @db.Uuid
  owner      AiCustomerState     @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@id([customerId, localId])
}

model AiConversation {
  commerce              AiCommerceState?
  commerceActions       AiCommerceAction[]
  checkouts             AiConversationCheckout[]
  claimedGuestTokenHash String?
  claimExpiresAt        DateTime?
  nextSequence          Int                      @default(0)
  id                    String                   @id @default(uuid()) @db.Uuid
  customerId            String?
  owner                 AiCustomerState?         @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  guestTokenHash        String?                  @unique
  guestExpiresAt        DateTime?
  locale                String
  context               Json
  contextRevision       Int                      @default(1)
  deletedAt             DateTime?
  expiresAt             DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  turns                 AiTurn[]
  messages              AiMessage[]

  @@index([customerId, createdAt, id])
  @@index([expiresAt])
}

model AiTurn {
  kind            String         @default("CHAT")
  context         Json
  id              String         @id @default(uuid()) @db.Uuid
  conversationId  String         @db.Uuid
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientMessageId String         @db.Uuid
  requestHash     String
  status          String
  errorCode       String?
  leaseExpiresAt  DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        AiMessage[]

  @@unique([id, conversationId])
  @@unique([conversationId, clientMessageId])
  @@index([conversationId, status])
}

model AiMessage {
  sequence       Int
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnId         String         @db.Uuid
  turn           AiTurn         @relation(fields: [turnId, conversationId], references: [id, conversationId], onDelete: Cascade)
  role           String
  text           String
  parts          Json
  createdAt      DateTime       @default(now())

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt, id])
}

model AiRateBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AiCommerceState {
  conversationId String         @id @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revision       Int            @default(1)
  cart           Json           @default("[]")
  draft          Json?
  stage          String         @default("BROWSING")
  quoteId        String?        @db.Uuid
  updatedAt      DateTime       @updatedAt
}

model AiCommerceAction {
  conversationId String         @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actionId       String         @db.Uuid
  requestHash    String
  result         Json
  createdAt      DateTime       @default(now())

  @@id([conversationId, actionId])
}

model AiConversationCheckout {
  quoteId         String         @id @db.Uuid
  conversationId  String         @db.Uuid
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId      String
  cartRevision    Int
  orderId         String?
  paymentIntentId String?        @unique
  status          String         @default("PREPARED")
  amount          Int
  currency        String
  lastObservation Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([conversationId, createdAt])
}

model CheckoutPolicy {
  currency                 String   @id
  revision                 Int      @default(1)
  pickupEnabled            Boolean  @default(true)
  deliveryEnabled          Boolean  @default(false)
  deliveryFee              Int      @default(0)
  deliveryCountries        String[] @default([])
  deliveryPostcodePrefixes String[] @default([])
  taxRateBps               Int      @default(0)
  updatedAt                DateTime @updatedAt
}

model CheckoutQuote {
  id              String                 @id @default(uuid()) @db.Uuid
  customerId      String
  requestId       String                 @db.Uuid
  conversationId  String?                @db.Uuid
  requestHash     String
  selection       Json
  snapshot        Json
  amount          Int
  currency        String
  state           String                 @default("OPEN")
  reservedAt      DateTime?
  paymentIntentId String?                @unique
  orderId         String?
  observation     Int                    @default(0)
  observedStatus  String?
  expiresAt       DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  events          PaymentCommerceEvent[]

  @@unique([customerId, requestId])
  @@index([expiresAt])
}

model PaymentCommerceEvent {
  id             String        @id @default(uuid()) @db.Uuid
  quoteId        String        @db.Uuid
  quote          CheckoutQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  observation    Int
  payload        Json
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  @@unique([quoteId, observation])
  @@index([acknowledgedAt, createdAt])
}
