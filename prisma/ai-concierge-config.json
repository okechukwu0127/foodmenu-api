{
  "enabled": true,
  "capabilities": {
    "chat": true,
    "guests": true,
    "profiles": true,
    "recommendations": true,
    "commerce": true
  },
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "content": {
    "welcome": {
      "en": "Your Personal\nFood Concierge"
    },
    "explanation": {
      "en": "Just chat or speak. I'll help you discover, customise and order your perfect meal."
    },
    "onboardingExplanation": {
      "en": "I can recommend better meals if I understand your preferences. You can skip this anytime."
    },
    "chatGreeting": {
      "en": "Hi! I’m Eazy Eat AI 👋\nWhat are you craving today?"
    },
    "chatStarters": [
      {
        "id": "something-spicy",
        "label": {
          "en": "Something spicy"
        },
        "prompt": {
          "en": "Recommend something spicy for me."
        },
        "icon": "flame"
      },
      {
        "id": "pizza-tonight",
        "label": {
          "en": "Pizza tonight"
        },
        "prompt": {
          "en": "Show me pizza options for tonight."
        },
        "icon": "pizza"
      },
      {
        "id": "healthy-meal",
        "label": {
          "en": "Healthy meal"
        },
        "prompt": {
          "en": "Recommend a healthy meal based on my preferences."
        },
        "icon": "leaf"
      },
      {
        "id": "within-budget",
        "label": {
          "en": "Under £15"
        },
        "prompt": {
          "en": "Recommend meals costing no more than £15."
        },
        "icon": "wallet"
      },
      {
        "id": "two-people",
        "label": {
          "en": "For 2 people"
        },
        "prompt": {
          "en": "Recommend a meal suitable for two people."
        },
        "icon": "users"
      },
      {
        "id": "surprise-me",
        "label": {
          "en": "Surprise me"
        },
        "prompt": {
          "en": "Surprise me with a meal based on my dining profile."
        },
        "icon": "sparkles"
      }
    ]
  },
